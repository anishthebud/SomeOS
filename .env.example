# vLLM model and OpenAI-compatible endpoint
MODEL_ID=google/gemma-4-12B-it-qat-w4a16-ct
SERVED_MODEL_NAME=gemma-4-12b-it
HOST=0.0.0.0
PORT=8000

# Conservative defaults for the ASUS Ascent GX10 / NVIDIA GB10.
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.50
DTYPE=bfloat16

# Optional. Set this before exposing the endpoint beyond a trusted LAN.
# VLLM_API_KEY=replace-with-a-long-random-value

# Optional for gated/private Hugging Face models. Gemma 4 12B is public.
# HF_TOKEN=hf_...

# To use the 23.9 GB BF16 checkpoint instead of Google's official W4A16
# serving checkpoint, set MODEL_ID=google/gemma-4-12B-it.
