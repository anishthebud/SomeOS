# Filesystem root containing sources/ and wiki/
VAULT_PATH=/home/asus/hackmit2026

# OpenAI-compatible local vLLM endpoint
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=gemma-4-12b-it

# Required: SomeOS knowledge APIs fail closed without a login or API token.
APP_PASSWORD=replace-with-a-long-random-password
APP_ORIGIN=https://your-machine.your-tailnet.ts.net

# Optional headless API access and required IoT capture key
API_TOKEN=
IOT_INGEST_KEY=replace-with-a-long-random-key

# Optional: audio/video ingestion. Any OpenAI-compatible /audio/transcriptions server
# (faster-whisper-server, vLLM Whisper, OpenAI). Without it, audio/video files preview
# fine but fail to ingest with a clear error.
# TRANSCRIBE_BASE_URL=http://127.0.0.1:8001/v1
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_API_KEY=
